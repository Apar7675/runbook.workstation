    <!-- Type -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted2}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="#CC152032"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SavedBar" TargetType="Border" BasedOn="{StaticResource SectionCard}">
        <Setter Property="Background" Value="#CC0D1626"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="ModuleCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="#CC101A2B"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="Effect" Value="{StaticResource RB.FocusGlowSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AreaCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="#CC101A2B"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="Effect" Value="{StaticResource RB.FocusGlowSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BubbleCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Background" Value="#C9142030"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="PanelFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="GlowWrap" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="TimeClockHeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="17"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{StaticResource RunBook.Brush.TimeClock.Gradient.Hero}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RunBook.Brush.TimeClock.Success.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="RunBook.Style.TimeClockHeroCard" TargetType="Border" BasedOn="{StaticResource TimeClockHeroCard}"/>
    <Style x:Key="TimeClockPanelCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{StaticResource RunBook.Brush.TimeClock.Gradient.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RunBook.Brush.TimeClock.Border.Default}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="TimeClockStatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RunBook.Brush.TimeClock.Neutral.Fill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RunBook.Brush.TimeClock.Neutral.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style x:Key="TimeClockHeroEyebrow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource RunBook.Brush.TimeClock.Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
