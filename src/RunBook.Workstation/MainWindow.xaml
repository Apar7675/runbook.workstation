                                                                            <TextBlock Text="{Binding AssignmentLabel}" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                            <TextBlock Text="{Binding ProgressLine}" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                            <TextBlock Text="{Binding ActiveOperatorLine}" Style="{StaticResource Sub}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                            <TextBlock Text="{Binding DueDate, StringFormat=Due {0}}" Style="{StaticResource Sub}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Style="{StaticResource Sub}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ModuleCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedWorkOrderTitle}" Style="{StaticResource H1}"/>
                                                <TextBlock Text="{Binding SelectedWorkOrderSummary}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding SelectedWorkOrderContext}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <UniformGrid Grid.Row="2" Columns="3">
                                                <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0"><TextBlock Text="{Binding WorkOrderDetail.CustomerName, StringFormat=Customer: {0}}" Style="{StaticResource Sub}" TextWrapping="Wrap"/></Border>
                                                <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0"><TextBlock Text="{Binding WorkOrderDetail.PoNumber, StringFormat=PO: {0}}" Style="{StaticResource Sub}" TextWrapping="Wrap"/></Border>
                                                <Border Style="{StaticResource SectionCard}"><TextBlock Text="{Binding WorkOrderDetail.SourceComponentId, StringFormat=Component: {0}}" Style="{StaticResource Sub}" TextWrapping="Wrap"/></Border>
                                            </UniformGrid>
                                            <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedWorkOrderProgressSummary}" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SelectedWorkOrderOperationsSummary}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SelectedWorkOrderActiveOperatorsSummary}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding WorkOrderDetail.ActiveOperators}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayLine}" Style="{StaticResource Sub}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="0.42*"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="0.26*"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="0.22*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Operations" Style="{StaticResource H2}"/>
                                                <DataGrid Grid.Row="2"
                                                          ItemsSource="{Binding WorkOrderDetail.Operations}"
                                                          SelectedItem="{Binding SelectedOperation}"
                                                          Style="{StaticResource PoGrid}"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Op" Binding="{Binding OperationNumber}" Width="70"/>
                                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                                        <DataGridTextColumn Header="Dept" Binding="{Binding Department}" Width="120"/>
                                                        <DataGridTextColumn Header="Cell" Binding="{Binding WorkCenter}" Width="120"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                                        <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName}" Width="140"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SelectedOperationTitle}" Style="{StaticResource H2}"/>
                                                            <TextBlock Text="{Binding SelectedOperationContext}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ActiveWorkContextLine}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBox Grid.Row="2"
                                                                 Text="{Binding OperationActionNoteText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="36"
                                                                 VerticalContentAlignment="Center"/>
                                                        <UniformGrid Grid.Row="4" Columns="4">
                                                            <Button Content="Start" Command="{Binding StartOperationCommand}" Style="{StaticResource RB.Button.Primary}" Margin="0,0,10,0" Height="48"/>
                                                            <Button Content="Stop" Command="{Binding StopOperationCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,10,0" Height="48"/>
                                                            <Button Content="Complete" Command="{Binding CompleteOperationCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,10,0" Height="48"/>
                                                            <Button Content="Need Help" Command="{Binding SubmitOperationHelpCommand}" Style="{StaticResource RB.Button.Danger}" Height="48"/>
                                                        </UniformGrid>
                                                        <Grid Grid.Row="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12">
                                                                <StackPanel>
                                                                    <TextBlock Text="Qty Complete" Style="{StaticResource Label}"/>
                                                                    <TextBox Text="{Binding QuantityReportText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Margin="0,8,0,8"/>
                                                                    <Button Content="Report Qty" Command="{Binding SubmitQuantityCommand}" Style="{StaticResource RB.Button.Primary}" Height="40"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="12">
                                                                <StackPanel>
                                                                    <TextBlock Text="Scrap Qty" Style="{StaticResource Label}"/>
                                                                    <TextBox Text="{Binding ScrapReportText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Margin="0,8,0,8"/>
                                                                    <Button Content="Report Scrap" Command="{Binding SubmitScrapCommand}" Style="{StaticResource RB.Button.Ghost}" Height="40"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="4" Style="{StaticResource SectionCard}" Padding="12">
                                                                <StackPanel>
                                                                    <TextBlock Text="Operator Note" Style="{StaticResource Label}"/>
                                                                    <TextBox Text="{Binding OperationNoteText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Margin="0,8,0,8"/>
                                                                    <Button Content="Add Note" Command="{Binding SubmitOperationNoteCommand}" Style="{StaticResource RB.Button.Ghost}" Height="40"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.05*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="0.95*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding InspectionTitle}" Style="{StaticResource H2}"/>
                                                                    <TextBlock Text="{Binding InspectionSubtitle}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshInspectionTasksCommand}" Style="{StaticResource RB.Button.Ghost}" Width="120"/>
                                                            </Grid>
                                                            <DataGrid Grid.Row="4"
                                                                      ItemsSource="{Binding InspectionTasks}"
                                                                      SelectedItem="{Binding SelectedInspectionTask}"
                                                                      Style="{StaticResource PoGrid}"
                                                                      IsReadOnly="True"
                                                                      CanUserAddRows="False">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Balloon" Binding="{Binding BalloonNumber}" Width="80"/>
                                                                    <DataGridTextColumn Header="Feature" Binding="{Binding FeatureText}" Width="*"/>
                                                                    <DataGridTextColumn Header="Input" Binding="{Binding InputType}" Width="110"/>
                                                                    <DataGridTextColumn Header="Actual" Binding="{Binding ActualValue}" Width="120"/>
                                                                    <DataGridTextColumn Header="Pass/Fail" Binding="{Binding PassFail}" Width="110"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="8"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding SelectedInspectionTaskTitle}" Style="{StaticResource H2}"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding SelectedInspectionTaskSummary}" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                                            <TextBox Grid.Row="4"
                                                                     Text="{Binding InspectionActualValue, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBox Grid.Row="6"
                                                                     Text="{Binding InspectionResultNoteText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="38"
                                                                     VerticalContentAlignment="Center"/>
                                                            <Button Grid.Row="8"
                                                                    Content="Submit Result"
                                                                    Command="{Binding SubmitInspectionResultCommand}"
                                                                    Style="{StaticResource RB.Button.Primary}"
                                                                    Height="40"
                                                                    Margin="0,10,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Visibility="{Binding IsDrawingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.15*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ModuleCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Work Orders With Released Drawings" Style="{StaticResource H2}"/>
                                                <TextBlock Text="Select a released work order to browse the Desktop-authoritative drawing package." Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding WorkOrders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectWorkOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource RB.Button.Ghost}"
                                                                    Margin="0,0,0,10"
                                                                    Padding="14">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding WorkOrderNumber}" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding PartNumber}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding HasDrawings, StringFormat=Drawings {0}}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ModuleCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Released Drawings" Style="{StaticResource H1}"/>
                                                <TextBlock Text="{Binding SelectedWorkOrderSummary}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding SelectedWorkOrderContext}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Refresh Work Orders" Command="{Binding RefreshWorkOrdersCommand}" Style="{StaticResource RB.Button.Ghost}" Width="180"/>
                                            <Grid Grid.Row="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Drawing Package" Style="{StaticResource H2}"/>
                                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DrawingReferences}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding Revision, StringFormat=Revision {0}}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                                                            <TextBlock Text="{Binding ContentType}" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1"
                                                                                Content="Open"
                                                                                Command="{Binding DataContext.OpenDrawingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource RB.Button.Primary}"
                                                                                Width="120"
                                                                                Margin="14,0,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
