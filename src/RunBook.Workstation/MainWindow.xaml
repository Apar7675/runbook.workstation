<Window x:Class="RunBook.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunBook Workstation" Width="1440" Height="920" MinWidth="1200" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBg}"
        PreviewKeyDown="Window_OnPreviewKeyDown" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/chatgpt_space_bg.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>
        <Rectangle IsHitTestVisible="False" Opacity="0.14" Fill="#0E1826"/>
        <Border Margin="28" Style="{StaticResource ShellFrame}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ShellSidebarSurface}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Source="pack://application:,,,/Assets/Images/logo.png"
                               Width="176"
                               Height="40"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>
                        <Border Grid.Row="2" Style="{StaticResource ModuleCard}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Workstation Identity" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding WorkstationIdentityLine}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ConnectivityLine}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AuthCacheStatus}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OfflineStatus}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="4" Style="{StaticResource ModuleCard}" Padding="16"
                                Visibility="{Binding ShowLoginPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Supervisor Session" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding ControlSessionStatus}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Control Email" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                <Border Style="{StaticResource GlowWrap}" Background="{StaticResource SurfaceDark}" Margin="0,0,0,8">
                                    <TextBox Style="{StaticResource Box}" Background="#00000000" Text="{Binding SettingsControlEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <TextBlock Text="Control Password" Style="{StaticResource Label}" Margin="0,2,0,6"/>
                                <Border Style="{StaticResource GlowWrap}" Background="{StaticResource SurfaceDark}">
                                    <PasswordBox x:Name="ControlPasswordBox"
                                                 PasswordChanged="ControlPasswordBox_OnPasswordChanged"
                                                 Padding="14,10"
                                                 Foreground="{StaticResource Text}"
                                                 Background="#00000000"
                                                 BorderThickness="0"/>
                                </Border>
                                <TextBlock Text="Desktop Pairing Code" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                <Border Style="{StaticResource GlowWrap}" Background="{StaticResource SurfaceDark}">
                                    <TextBox Style="{StaticResource Box}"
                                             Background="#00000000"
                                             Text="{Binding SettingsPairingCode, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <TextBlock Text="Required only when enrolling, replacing, or re-enrolling this workstation with Desktop."
                                           Style="{StaticResource Sub}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Margin="0,12,0,0">
                                    <Button Content="Supervisor Sign In" Command="{Binding ConnectControlCommand}" Style="{StaticResource RB.Button.Primary}" Margin="0,0,0,10"/>
                                    <Button Content="Clear Session" Command="{Binding DisconnectControlCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,0,10"/>
                                    <Button Content="Enroll / Refresh Registration" Command="{Binding RefreshRegistrationCommand}" Style="{StaticResource RB.Button.Ghost}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="6" Style="{StaticResource ModuleCard}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Authorized Modules" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding SessionModulesLine}" Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding VisibleModules}" Margin="0,12,0,0" Visibility="{Binding ShowModulesShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}"
                                                    Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RB.Button.Ghost}"
                                                    Margin="0,0,0,10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="8">
                            <Button Content="Enroll / Refresh Registration" Command="{Binding RefreshRegistrationCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,0,10"/>
                            <Button Content="Workstation Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,0,10"/>
                            <Button Content="Log Out / Switch User" Command="{Binding LogoutCommand}" Style="{StaticResource RB.Button.Danger}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#12000000">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ModuleCard}" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Workstation" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding WorkstationIdentityLine}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="State" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding SessionEmployeeName}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Instruction" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Tap an employee and enter a 4 to 6 digit passcode to unlock workstation access."
                                               Foreground="{StaticResource Muted2}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="5"
                                              ItemsSource="{Binding ConnectionStatuses}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ConnectionStatusPill}"
                                                    Background="{Binding BackgroundColor}"
                                                    BorderBrush="{Binding BorderColor}">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource StatusToolTipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Text}"/>
                                                            <TextBlock Text="{Binding Reason}"
                                                                       Margin="0,4,0,0"
                                                                       MaxWidth="260"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Muted}"/>
                                                            <TextBlock Text="{Binding DetailText}"
                                                                       Margin="0,6,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource Muted2}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Foreground="{StaticResource Text}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Grid.Column="6" Style="{StaticResource HeaderDateTimeCard}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderDateText}" Style="{StaticResource HeaderDateText}"/>
                                        <TextBlock Text="{Binding HeaderTimeText}" Style="{StaticResource HeaderTimeText}"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="7" Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource RB.Button.Ghost}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="8" Content="Refresh Time Clock" Command="{Binding RefreshTimeClockCommand}" Style="{StaticResource RB.Button.Primary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid Visibility="{Binding ShowLoginPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource ModuleCard}" Padding="20,18,18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Employee Roster" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AuthCacheStatus}"
                                                       Style="{StaticResource Sub}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False"
                                                      Padding="0,0,6,0">
                                            <ItemsControl ItemsSource="{Binding RosterEmployees}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"
                                                                   ItemWidth="170"
                                                                   ItemHeight="140"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenRosterEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#00000000"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Margin="6,8"
                                                                Cursor="Hand"
                                                                FocusVisualStyle="{x:Null}">
                                                            <StackPanel Width="158" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border Width="68"
                                                                        Height="68"
                                                                        CornerRadius="34"
                                                                        Background="{Binding AvatarBrush}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        BorderThickness="2"
                                                                        HorizontalAlignment="Center">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#44000000"/>
                                                                    </Border.Effect>
                                                                    <Grid>
                                                                        <Ellipse Margin="2">
                                                                            <Ellipse.Fill>
                                                                                <ImageBrush ImageSource="{Binding AvatarDisplayUrl}" Stretch="UniformToFill"/>
                                                                            </Ellipse.Fill>
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasAvatarDisplayUrl}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding Initials}"
                                                                                   Foreground="White"
                                                                                   FontSize="22"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasAvatarDisplayUrl}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Foreground="{StaticResource Text}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,8,0,0"
                                                                           Width="112"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Grid Visibility="{Binding IsPasscodeDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Rectangle Fill="#8A07101A"/>
                                    <Border MaxWidth="470"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="28"
                                            Padding="26"
                                            Background="#F1142033"
                                            BorderBrush="#4672A8D8"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <Border Width="78" Height="78" CornerRadius="39"
                                                        Background="{Binding SelectedRosterEmployee.AvatarBrush}"
                                                        BorderBrush="{Binding SelectedRosterEmployee.AccentBrush}"
                                                        BorderThickness="3"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <Ellipse Margin="2">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding SelectedRosterEmployee.AvatarDisplayUrl}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedRosterEmployee.HasAvatarDisplayUrl}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding SelectedRosterEmployee.Initials}"
                                                                   Foreground="White"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedRosterEmployee.HasAvatarDisplayUrl}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding PasscodeDialogTitle}" Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                                <TextBlock Text="{Binding PasscodeDialogSubtitle}" Style="{StaticResource Sub}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding PasscodeDialogModuleSummary}" Foreground="{Binding SelectedRosterEmployee.AccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Row="2" CornerRadius="16" Padding="16,14" Background="#E20A1220" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Passcode" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding PasscodeMaskDisplay}" Foreground="{StaticResource Text}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    <TextBlock Text="Enter 4 to 6 digits" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <UniformGrid Grid.Row="4" Columns="3" Rows="4">
                                                <Button Content="1" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="1" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="2" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="2" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="3" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="3" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="4" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="4" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="5" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="5" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="6" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="6" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="7" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="7" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="8" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="8" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="9" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="9" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="Clear" Command="{Binding ClearPasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="18" Margin="0,0,10,0"/>
                                                <Button Content="0" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="0" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,0"/>
                                                <Button Content="Back" Command="{Binding BackspacePasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="18" Margin="0,0,0,0"/>
                                            </UniformGrid>
                                            <UniformGrid Grid.Row="6" Columns="2">
                                                <Button Content="Cancel" Command="{Binding CancelPasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="54" FontSize="18" Margin="0,0,10,0"/>
                                                <Button Content="Unlock" Command="{Binding LoginCommand}" Style="{StaticResource RB.Button.Primary}" Height="54" FontSize="18" Margin="10,0,0,0"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid Visibility="{Binding ShowNoAccessAssigned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource ModuleCard}" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="No Access Assigned" Style="{StaticResource H1}"/>
                                        <TextBlock Text="This employee signed in successfully, but no workstation modules are assigned yet. Use RunBook Desktop to enable workstation access and choose modules for this employee."
                                                   Style="{StaticResource Sub}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Visibility="{Binding ShowModulesShell, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Visibility="{Binding IsTimeClockSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.02*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="0.98*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource TimeClockHeroCard}"
                                                Background="{Binding TimeClockHeroBackgroundBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel HorizontalAlignment="Left">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding TimeClockHeroAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CURRENT STATUS" Style="{StaticResource TimeClockHeroEyebrow}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="{Binding TimeClockHeroTitle}" Style="{StaticResource TimeClockHeroTitle}"/>
                                                    <TextBlock Text="{Binding TimeClockHeroStatusLabel}" Style="{StaticResource TimeClockHeroStatus}" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding TimeClockHeroPrimaryLine}" Style="{StaticResource TimeClockHeroMeta}" Margin="0,10,0,0"/>
                                                    <TextBlock Text="{Binding TimeClockHeroSecondaryLine}" Style="{StaticResource TimeClockHeroMeta}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="4" Text="{Binding TimeClockHeroHelperText}" Style="{StaticResource TimeClockHeroHint}"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Style="{StaticResource TimeClockPanelCard}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Next Action" Style="{StaticResource TimeClockSectionTitle}"/>
                                                    <TextBlock Text="Only the actions that make sense right now are shown." Style="{StaticResource TimeClockSectionBody}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2">
                                                    <Button Content="Clock In" Command="{Binding ClockInCommand}" Style="{StaticResource TimeClockActionPrimary}" Visibility="{Binding ShowClockInAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Grid Visibility="{Binding ShowWorkingActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Row="0" Grid.Column="0" Content="Start Break" Command="{Binding BreakStartCommand}" Style="{StaticResource TimeClockActionSecondary}"/>
                                                        <Button Grid.Row="0" Grid.Column="2" Content="Clock Out" Command="{Binding ClockOutCommand}" Style="{StaticResource TimeClockActionSecondary}"/>
                                                        <Button Grid.Row="2" Grid.ColumnSpan="3" Content="Start Lunch" Command="{Binding LunchStartCommand}" Style="{StaticResource TimeClockActionSecondary}" Visibility="{Binding ShowLunchStartAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                    <Button Content="End Break" Command="{Binding BreakEndCommand}" Style="{StaticResource TimeClockActionPrimary}" Visibility="{Binding ShowBreakEndAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Content="End Lunch" Command="{Binding LunchEndCommand}" Style="{StaticResource TimeClockActionPrimary}" Visibility="{Binding ShowLunchEndAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="4" Style="{StaticResource TimeClockPanelCard}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Request Time Off" Style="{StaticResource TimeClockSectionTitle}"/>
                                                    <TextBlock Text="{Binding TimeOffSectionSubtitle}" Style="{StaticResource TimeClockSectionBody}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="12"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
