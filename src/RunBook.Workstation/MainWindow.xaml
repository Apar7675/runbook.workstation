                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="#EAF2FF" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Open" Command="{Binding DataContext.OpenPacketDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource RB.Button.Primary}" Width="118" Height="34" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Row="2" CornerRadius="16" Background="#E90B1626" BorderBrush="#294766" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding InspectionTitle}" Foreground="#EAF2FF" FontSize="18" FontWeight="SemiBold"/>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding InspectionTasks}"
                                      SelectedItem="{Binding SelectedInspectionTask, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Background="#07111E"
                                      Foreground="#EAF2FF"
                                      RowBackground="#0B1626"
                                      AlternatingRowBackground="#10233A"
                                      BorderBrush="#294766"
                                      HorizontalGridLinesBrush="#1E3654"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Balloon" Binding="{Binding BalloonNumber}" Width="70"/>
                                    <DataGridTextColumn Header="Feature" Binding="{Binding FeatureText}" Width="2*"/>
                                    <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal}" Width="90"/>
                                    <DataGridTextColumn Header="+Tol" Binding="{Binding TolPlus}" Width="70"/>
                                    <DataGridTextColumn Header="-Tol" Binding="{Binding TolMinus}" Width="70"/>
                                    <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="120"/>
                                    <DataGridTextColumn Header="Actual" Binding="{Binding ActualValue}" Width="110"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding PassFail}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border Background="#F7050B14"
                BorderBrush="#294766"
                BorderThickness="1"
                CornerRadius="18"
                Margin="12"
                Padding="20"
                Visibility="{Binding IsRunBookAlertOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Rectangle Fill="#8A07101A"/>
                <Border MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="24"
                        Padding="24"
                        Background="#F1142033"
                        BorderBrush="{StaticResource RunBook.Brush.Primary.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="14"
                                    Background="{StaticResource RunBook.Brush.Active.Subtle}"
                                    BorderBrush="{StaticResource RunBook.Brush.Active.Border}"
                                    BorderThickness="1">
                                <TextBlock Text="!"
                                           Foreground="{StaticResource RunBook.Brush.Active}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RunBookAlertTitle}"
                                           Foreground="{StaticResource RunBook.Brush.Text.Primary}"
                                           FontSize="24"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="RunBook Workstation"
                                           Foreground="{StaticResource RunBook.Brush.Text.Muted}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="16"
                                Padding="16"
                                Background="{StaticResource RunBook.Brush.Surface.Card}"
                                BorderBrush="{StaticResource RunBook.Brush.Border.Default}"
                                BorderThickness="1"
                                Margin="0,18,0,18">
                            <TextBlock Text="{Binding RunBookAlertBody}"
                                       Foreground="{StaticResource RunBook.Brush.Text.Secondary}"
                                       FontSize="14"
                                       LineHeight="22"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Content="{Binding RunBookAlertSecondaryText}"
                                    Command="{Binding RunBookAlertSecondaryCommand}"
                                    Style="{StaticResource RB.Button.Ghost}"
                                    Width="128"
                                    Height="42"
                                    Visibility="{Binding ShowRunBookAlertSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="3"
                                    Content="{Binding RunBookAlertPrimaryText}"
                                    Command="{Binding RunBookAlertPrimaryCommand}"
                                    Style="{StaticResource RB.Button.Primary}"
                                    MinWidth="128"
                                    Height="42"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Background="#F7050B14"
                BorderBrush="#294766"
                BorderThickness="1"
                CornerRadius="18"
                Margin="12"
                Padding="20"
                Visibility="{Binding IsMobileCaptureDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="14,10" CornerRadius="14" Background="#E90B1626" BorderBrush="#294766" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mobile Capture" Foreground="#EAF2FF" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedOperationTitle}" Foreground="#9FB0C8" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Close"
                                Command="{Binding CloseMobileCaptureCommand}"
                                Style="{StaticResource RB.Button.Ghost}"
                                Width="110"
                                Height="40"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" CornerRadius="18" Background="#E90B1626" BorderBrush="#294766" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="12" Padding="14" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Image Source="{Binding MobileCaptureQrImage}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Scan this QR code with the phone camera." Foreground="#EAF2FF" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="The phone opens a secure local capture page. Photos and PDFs upload to RunBook Service and are linked only to this selected work-order operation." Foreground="#9FB0C8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,14"/>
                            <TextBlock Text="Attachment Type" Foreground="#70839F" FontSize="11" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding MobileCaptureTypes}"
                                      SelectedItem="{Binding SelectedMobileCaptureType, Mode=TwoWay}"
                                      Style="{StaticResource RB.ComboBox}"
                                      Height="38"
                                      Margin="0,5,0,12"/>
                            <TextBlock Text="Short URL" Foreground="#70839F" FontSize="11" FontWeight="SemiBold"/>
                            <Border Padding="10" CornerRadius="10" Background="#07111E" BorderBrush="#294766" BorderThickness="1" Margin="0,5,0,10">
                                <TextBlock Text="{Binding MobileCaptureUrl}" Foreground="#EAF2FF" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding MobileCaptureExpiresText}" Foreground="#F5B84B" FontSize="12" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="New Link"
                                        Command="{Binding OpenMobileCaptureCommand}"
                                        Style="{StaticResource RB.Button.Primary}"
                                        Width="130"
                                        Height="38"
                                        Margin="0,0,10,0"/>
                                <Button Content="Refresh Attachments"
                                        Command="{Binding RefreshOperationAttachmentsCommand}"
                                        Style="{StaticResource RB.Button.Ghost}"
                                        Width="170"
                                        Height="38"/>
                            </WrapPanel>
                            <TextBlock Text="After upload, tap Refresh Attachments or close this window to see the evidence list update." Foreground="#9FB0C8" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
