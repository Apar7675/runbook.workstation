<Window x:Class="RunBook.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunBook Workstation" Width="1440" Height="920" MinWidth="1200" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBg}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewTextInput="Window_OnPreviewTextInput"
        PreviewMouseMove="Window_OnPreviewMouseMove"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="WorkstationFullWidthButtonStyle" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Outer"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border x:Name="Inner"
                                        CornerRadius="11"
                                        Background="#00000000"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#162A46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#1D3760"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkstationDisabledSegmentStyle" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#14243A"/>
            <Setter Property="BorderBrush" Value="#294766"/>
            <Setter Property="Foreground" Value="#70839F"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="RosterEmployeeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelcomePanelCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Background" Value="#F40B111A"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="WelcomeInnerCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#FF101824"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="WelcomeActionCardButton" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FF101824"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFF4F7FB"/>
            <Setter Property="Height" Value="248"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="OuterGlow"
                                    Margin="6"
                                    CornerRadius="22"
                                    Opacity="0.18"
                                    Background="{TemplateBinding BorderBrush}"/>
                            <Border x:Name="Outer"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <Border x:Name="Inner"
                                        CornerRadius="18"
                                        Background="#04000000"
                                        Padding="0">
                                    <ContentPresenter/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#FF142033"/>
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Inner" Property="Background" Value="#050D1520"/>
                                <Setter TargetName="OuterGlow" Property="Opacity" Value="0.32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#FF0D1520"/>
                                <Setter TargetName="OuterGlow" Property="Opacity" Value="0.24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelcomeShortcutButton" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#FF0D1520"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ShortcutBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ShortcutBorder" Property="Background" Value="#FF142033"/>
                                <Setter TargetName="ShortcutBorder" Property="BorderBrush" Value="#FF3F6EB7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ShortcutBorder" Property="Background" Value="#FF0B111A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ShortcutBorder" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WelcomeSearchButton" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Background" Value="#FF0D1520"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SearchButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchButtonBorder" Property="Background" Value="#FF142033"/>
                                <Setter TargetName="SearchButtonBorder" Property="BorderBrush" Value="#FF3F6EB7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SearchButtonBorder" Property="Background" Value="#FF0B111A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SearchButtonBorder" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactStatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PasscodeDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="9,0"/>
            <Setter Property="Stroke" Value="#FF344154"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="#140D1520"/>
        </Style>
        <Style x:Key="TimeClockWeekNavButton" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF101824"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="TimeClockWeekCurrentButton" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF101824"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/chatgpt_space_bg.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>
        <Rectangle IsHitTestVisible="False" Opacity="0.14" Fill="#0E1826"/>
        <Border Margin="12" Style="{StaticResource ShellFrame}">
            <Grid>
                <Border Background="#12000000">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="12,8"
                                CornerRadius="14"
                                BorderBrush="{StaticResource RunBook.Brush.Border.Default}"
                                BorderThickness="1"
                                Background="{StaticResource RunBook.Brush.Surface.Shell}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowLoginPanel}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="pack://application:,,,/Assets/Images/logo.png"
                                       Width="126"
                                       Height="34"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="1" Height="38" Background="{StaticResource RunBook.Brush.Border.Default}" Margin="0,0,16,0"/>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,26,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WorkstationIdentityLine}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Workstation" Foreground="{StaticResource RunBook.Brush.Text.Muted}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding SessionEmployeeName}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentOperatorStatusLine}" Foreground="{StaticResource RunBook.Brush.Success}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="4"
                                                  ItemsSource="{Binding ConnectionStatuses}"
                                                  Margin="0,0,14,0"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ConnectionStatusPill}"
                                                        Background="{Binding BackgroundColor}"
                                                        BorderBrush="{Binding BorderColor}">
                                                    <Border.ToolTip>
                                                        <ToolTip Style="{StaticResource StatusToolTipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Text}"/>
                                                                <TextBlock Text="{Binding Reason}"
                                                                           Margin="0,4,0,0"
                                                                           MaxWidth="260"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Muted}"/>
                                                                <TextBlock Text="{Binding DetailText}"
                                                                           Margin="0,6,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource Muted2}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   Foreground="{StaticResource Text}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.Column="4"
                                            Padding="12,8"
                                            CornerRadius="10"
                                            Background="{Binding ServiceStatusBackgroundBrush}"
                                            BorderBrush="{Binding ServiceStatusAccentBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding ServiceStatusAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="SERVICE READY" Foreground="#FFF4F7FB" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ServiceStatusDetail}" Foreground="#FFAAB6C8" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource HeaderDateTimeCard}" Padding="14,8" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderDateText}" Style="{StaticResource HeaderDateText}"/>
                                            <TextBlock Text="{Binding HeaderTimeText}" Style="{StaticResource HeaderTimeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="6"
                                            Content="Save Settings"
                                            Command="{Binding SaveSettingsCommand}"
                                            IsEnabled="{Binding HasSupervisorSession}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Supervisor sign-in required.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="7"
                                            Content="{Binding RefreshConnectionsButtonText}"
                                            Command="{Binding RefreshEmployeeAuthCommand}"
                                            IsEnabled="{Binding HasSupervisorSession}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Supervisor sign-in required.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RB.Button.Primary}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="6"
                                            Content="Refresh"
                                            Command="{Binding RefreshWorkOrdersCommand}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="7"
                                            Content="Supervisor Access"
                                            Command="{Binding OpenSupervisorDialogCommand}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RB.Button.Primary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorkOrdersSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="8" Command="{Binding LogoutCommand}" Style="{StaticResource RB.Button.Ghost}" VerticalAlignment="Center" MinWidth="150" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding IdleLogoutButtonText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinWidth="58"
                                                    Padding="8,3"
                                                    CornerRadius="999"
                                                    Background="#2CFFFFFF"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Visibility="{Binding ShowIdleLogoutBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding IdleLogoutBadgeText}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                            </Grid>
                        </Border>
                            <Grid Grid.Row="1"
                                  Visibility="{Binding ShowLoginPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Border CornerRadius="26"
                                        Padding="22,20,22,18"
                                        Background="#FF070A0F"
                                        BorderBrush="#FF1C2735"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource WelcomePanelCard}" Padding="20,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Assets/Images/logo.png"
                                                           Width="68"
                                                           Height="68"
                                                           Stretch="Uniform"
                                                           Margin="0,0,18,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="RUNBOOK" Foreground="#FFF4F7FB" FontSize="28" FontWeight="SemiBold"/>
                                                        <TextBlock Text="WORKSTATION" Foreground="#FF38D5FF" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StationAreaLabel}" Foreground="#FFF4F7FB" FontSize="20" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StationSubtitle}" Foreground="#FFAAB6C8" FontSize="14" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="3"
                                                        Padding="18,12"
                                                        CornerRadius="8"
                                                        Background="{Binding ServiceStatusBackgroundBrush}"
                                                        BorderBrush="#FF243246"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="14" Height="14" Fill="{Binding ServiceStatusAccentBrush}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ServiceStatusHeadline}" Foreground="{Binding ServiceStatusAccentBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding ServiceStatusDetail}" Foreground="#FFAAB6C8" FontSize="12" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding HeaderTimeText}" Foreground="#FFF4F7FB" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding HeaderDateText}" Foreground="#FFAAB6C8" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <Button Grid.Column="7"
                                                        Command="{Binding OpenSupervisorDialogCommand}"
                                                        Style="{StaticResource WelcomeSearchButton}"
                                                        Padding="22,0"
                                                        MinWidth="232"
                                                        Height="64"
                                                        VerticalAlignment="Center">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE72E;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="#FF38D5FF"
                                                                   FontSize="22"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="SUPERVISOR ACCESS"
                                                                   Foreground="#FF38D5FF"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="360"/>
