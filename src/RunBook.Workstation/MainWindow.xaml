<Window x:Class="RunBook.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunBook Workstation" Width="1440" Height="920" MinWidth="1200" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBg}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewTextInput="Window_OnPreviewTextInput"
        PreviewMouseMove="Window_OnPreviewMouseMove"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="WorkstationFullWidthButtonStyle" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Outer"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border x:Name="Inner"
                                        CornerRadius="11"
                                        Background="#00000000"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#162A46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#1D3760"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkstationDisabledSegmentStyle" TargetType="Button" BasedOn="{StaticResource RB.Button.Ghost}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#14243A"/>
            <Setter Property="BorderBrush" Value="#294766"/>
            <Setter Property="Foreground" Value="#70839F"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="RosterEmployeeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/Images/chatgpt_space_bg.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Grid.Background>
        <Rectangle IsHitTestVisible="False" Opacity="0.14" Fill="#0E1826"/>
        <Border Margin="12" Style="{StaticResource ShellFrame}">
            <Grid>
                <Border Background="#12000000">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="12,8"
                                CornerRadius="14"
                                BorderBrush="#263B5C"
                                BorderThickness="1"
                                Background="#E8070D18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="pack://application:,,,/Assets/Images/logo.png"
                                       Width="126"
                                       Height="34"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="1" Height="38" Background="#263B5C" Margin="0,0,16,0"/>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,26,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WorkstationIdentityLine}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Workstation" Foreground="#8EA2C4" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding SessionEmployeeName}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentOperatorStatusLine}" Foreground="#74E3A0" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="4"
                                                  ItemsSource="{Binding ConnectionStatuses}"
                                                  Margin="0,0,14,0"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ConnectionStatusPill}"
                                                        Background="{Binding BackgroundColor}"
                                                        BorderBrush="{Binding BorderColor}">
                                                    <Border.ToolTip>
                                                        <ToolTip Style="{StaticResource StatusToolTipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Text}"/>
                                                                <TextBlock Text="{Binding Reason}"
                                                                           Margin="0,4,0,0"
                                                                           MaxWidth="260"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Muted}"/>
                                                                <TextBlock Text="{Binding DetailText}"
                                                                           Margin="0,6,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource Muted2}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   Foreground="{StaticResource Text}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.Column="5" Style="{StaticResource HeaderDateTimeCard}" Padding="14,8" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderDateText}" Style="{StaticResource HeaderDateText}"/>
                                            <TextBlock Text="{Binding HeaderTimeText}" Style="{StaticResource HeaderTimeText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="6"
                                            Content="Save Settings"
                                            Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource RB.Button.Ghost}"
                                            IsEnabled="{Binding HasSupervisorSession}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Supervisor sign-in required."/>
                                    <Button Grid.Column="7"
                                            Content="{Binding RefreshConnectionsButtonText}"
                                            Command="{Binding RefreshEmployeeAuthCommand}"
                                            Style="{StaticResource RB.Button.Primary}"
                                            IsEnabled="{Binding HasSupervisorSession}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Supervisor sign-in required."/>
                                    <Button Grid.Column="8" Command="{Binding LogoutCommand}" Style="{StaticResource RB.Button.Ghost}" VerticalAlignment="Center" MinWidth="150" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding IdleLogoutButtonText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinWidth="58"
                                                    Padding="8,3"
                                                    CornerRadius="999"
                                                    Background="#2CFFFFFF"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Visibility="{Binding ShowIdleLogoutBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding IdleLogoutBadgeText}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                            </Grid>
                        </Border>
                            <Grid Grid.Row="1"
                                  Visibility="{Binding ShowLoginPanel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <Border Style="{StaticResource ModuleCard}" Padding="20,18,18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Employee Roster" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AuthCacheStatus}"
                                                       Style="{StaticResource Sub}"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False"
                                                      Padding="0,0,6,0">
                                            <StackPanel>
                                                <Button Command="{Binding OpenSupervisorDialogCommand}"
                                                        Style="{StaticResource RosterEmployeeButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="6,8,6,14"
                                                        ToolTip="Supervisor sign-in opens workstation settings and registration tools.">
                                                    <StackPanel Width="158" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="68"
                                                              Height="68"
                                                              HorizontalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </Grid.RenderTransform>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#66000000" Opacity="0.9"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#B38B63F2" Opacity="1"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <ScaleTransform ScaleX="1.14" ScaleY="1.14"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Ellipse Stroke="#9F82FF"
                                                                     StrokeThickness="2">
                                                                <Ellipse.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#274F9D" Offset="0"/>
                                                                        <GradientStop Color="#5E84C6" Offset="0.52"/>
                                                                        <GradientStop Color="#8B63F2" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Margin="7" Fill="#E7111B2C" Stroke="#44FFFFFF" StrokeThickness="1"/>
                                                            <Image Source="pack://application:,,,/Assets/Images/logo.png"
                                                                   Width="44"
                                                                   Height="44"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="Supervisor"
                                                                   Foreground="{StaticResource Text}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   Margin="0,8,0,0"
                                                                   Width="112"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Admin access"
                                                                   Foreground="{StaticResource Muted2}"
                                                                   FontSize="11"
                                                                   TextAlignment="Center"
                                                                   Margin="0,3,0,0"
                                                                   Width="124"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding DataContext.RosterEmployees, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"
                                                                   ItemWidth="170"
                                                                   ItemHeight="140"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenRosterEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource RosterEmployeeButtonStyle}">
                                                            <StackPanel Width="158" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid Width="68"
                                                                      Height="68"
                                                                      HorizontalAlignment="Center"
                                                                      RenderTransformOrigin="0.5,0.5">
                                                                    <Grid.RenderTransform>
                                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                    </Grid.RenderTransform>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#55000000" Opacity="0.9"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#B36FD6FF" Opacity="1"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <ScaleTransform ScaleX="1.14" ScaleY="1.14"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Ellipse Fill="{Binding AvatarBrush}"
                                                                             Stroke="{Binding AccentBrush}"
                                                                             StrokeThickness="2"/>
                                                                    <Ellipse Margin="2">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasAvatarDisplayUrl}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                        <Ellipse.Fill>
                                                                            <ImageBrush ImageSource="{Binding AvatarDisplayUrl}"
                                                                                        Stretch="UniformToFill"
                                                                                        AlignmentX="Center"
                                                                                        AlignmentY="Center"/>
                                                                        </Ellipse.Fill>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               Foreground="White"
                                                                               FontSize="22"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasAvatarDisplayUrl}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Foreground="{StaticResource Text}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,8,0,0"
                                                                           Width="112"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Grid Visibility="{Binding IsPasscodeDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Rectangle Fill="#8A07101A"/>
                                    <Border MaxWidth="470"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="28"
                                            Padding="26"
                                            Background="#F1142033"
                                            BorderBrush="#4672A8D8"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="18"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <Grid Width="78" Height="78" HorizontalAlignment="Center">
                                                    <Ellipse Fill="{Binding SelectedRosterEmployee.AvatarBrush}"
                                                             Stroke="{Binding SelectedRosterEmployee.AccentBrush}"
                                                             StrokeThickness="3"/>
                                                    <Ellipse Margin="2">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedRosterEmployee.HasAvatarDisplayUrl}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding SelectedRosterEmployee.AvatarDisplayUrl}"
                                                                        Stretch="UniformToFill"
                                                                        AlignmentX="Center"
                                                                        AlignmentY="Center"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding SelectedRosterEmployee.Initials}"
                                                               Foreground="White"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedRosterEmployee.HasAvatarDisplayUrl}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding PasscodeDialogTitle}" Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                                <TextBlock Text="{Binding PasscodeDialogSubtitle}" Style="{StaticResource Sub}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding PasscodeDialogModuleSummary}" Foreground="{Binding SelectedRosterEmployee.AccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Row="2" CornerRadius="16" Padding="16,14" Background="#E20A1220" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Passcode" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding PasscodeMaskDisplay}" Foreground="{StaticResource Text}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    <TextBlock Text="Enter 4 to 6 digits" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <UniformGrid Grid.Row="4" Columns="3" Rows="4">
                                                <Button Content="1" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="1" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="2" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="2" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="3" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="3" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="4" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="4" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="5" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="5" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="6" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="6" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="7" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="7" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="8" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="8" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,10"/>
                                                <Button Content="9" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="9" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,0,10"/>
                                                <Button Content="Clear" Command="{Binding ClearPasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="18" Margin="0,0,10,0"/>
                                                <Button Content="0" Command="{Binding AppendPasscodeDigitCommand}" CommandParameter="0" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="22" Margin="0,0,10,0"/>
                                                <Button Content="Back" Command="{Binding BackspacePasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="62" FontSize="18" Margin="0,0,0,0"/>
                                            </UniformGrid>
                                            <UniformGrid Grid.Row="6" Columns="2">
                                                <Button Content="Cancel" Command="{Binding CancelPasscodeCommand}" Style="{StaticResource RB.Button.Ghost}" Height="54" FontSize="18" Margin="0,0,10,0"/>
                                                <Button Content="Unlock" Command="{Binding LoginCommand}" Style="{StaticResource RB.Button.Primary}" Height="54" FontSize="18" Margin="10,0,0,0"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Visibility="{Binding IsSupervisorDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Rectangle Fill="#9007101A"/>
                                    <Border MaxWidth="720"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="28"
                                            Padding="26"
                                            Background="#F1142033"
                                            BorderBrush="#4672A8D8"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="64" Height="64">
                                                    <Ellipse Stroke="#9F82FF" StrokeThickness="2">
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#274F9D" Offset="0"/>
                                                                <GradientStop Color="#5E84C6" Offset="0.52"/>
                                                                <GradientStop Color="#8B63F2" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
